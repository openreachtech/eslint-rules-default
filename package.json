{
  "name": "@openreachtech/eslint-rules-default",
  "version": "2.0.2",
  "description": "A showcasing package all the rules of ESLint.",
  "main": "lib/index.js",
  "files": [
    "configurations/",
    "types/"
  ],
  "scripts": {
    "audit:actions": "node node_modules/@openreachtech/mentsu-github-actions-inspector/scripts/audit-action-version.js",
    "audit:npm": "node node_modules/@openreachtech/mentsu-npm-audit-gate/scripts/npm-audit-gate.js scripts/stopgap-audit/IGNORED_ADVISORIES.js",
    "l": "npm run lint",
    "lint": "eslint .",
    "test": "export NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\"; jest --maxWorkers=5"
  },
  "type": "module",
  "keywords": [
    "ESLint"
  ],
  "author": "Open Reach Tech Inc.",
  "license": "Apache-2.0",
  "dependencies": {
    "@eslint/js": "^9.31.0",
    "@stylistic/eslint-plugin": "^5.2.0"
  },
  "devDependencies": {
    "@openreachtech/mentsu-github-actions-inspector": "^0.1.0",
    "@openreachtech/mentsu-npm-audit-gate": "^0.1.1",
    "@types/jest": "^30.0.0",
    "eslint": "^9.31.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jsdoc": "^51.4.1",
    "eslint-plugin-openreachtech": "^1.0.1",
    "jest": "^30.0.4"
  },
  "overrides": {
    "glob@>=9": "^14.0.2",
    "minimatch@>=7": "^11.0.1"
  }
}
